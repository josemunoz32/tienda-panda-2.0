<Window x:Class="PandaStoreLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizando PandaStore" Height="250" Width="450"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    
    <Border Background="#120F17" CornerRadius="15" BorderBrush="#8E2DE2" BorderThickness="2" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="🚀 Actualizando PandaStore Launcher" 
                           Foreground="White" FontSize="18" FontWeight="Bold" 
                           HorizontalAlignment="Center" />
                <Button Content="✕" Click="BtnClose_Click" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="#888888" BorderThickness="0" 
                        FontSize="14" FontWeight="Bold" Cursor="Hand" Margin="0,-5,-5,0"
                        ToolTip="Omitir actualización por ahora y abrir el Launcher"/>
            </Grid>

            <TextBlock x:Name="lblStatus" 
                       Text="Descargando nueva versión..." 
                       Foreground="#DDDDDD" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" />

            <ProgressBar x:Name="pbDownload" 
                         Height="15" Minimum="0" Maximum="100" Value="0" 
                         Foreground="#A259FF" Background="#2A2438" 
                         Grid.Row="2" Margin="0,15,0,5" />

            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Button Content="Omitir por ahora" Click="BtnClose_Click"
                        HorizontalAlignment="Left" Background="#211833" Foreground="#B3A2C7" BorderBrush="#3D2B5E" BorderThickness="1"
                        Padding="10,4" FontSize="11" Cursor="Hand"/>
                <TextBlock x:Name="lblProgress" 
                           Text="0%" 
                           Foreground="White" FontSize="12" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
