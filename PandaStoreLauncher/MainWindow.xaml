                                        <!-- Claim Gift Button -->
                                        <Button x:Name="btnClaimLoyaltyReward" 
                                                Content="🎁 Reclamar Juego Gratis por WhatsApp" 
                                                Style="{StaticResource GoldButtonStyle}" 
                                                Padding="14,10" 
                                                FontSize="12" 
                                                FontWeight="Bold" 
                                                Cursor="Hand"
                                                Click="BtnClaimLoyaltyReward_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cerrar" 
                                    Style="{StaticResource VacButtonStyle}" 
                                    Foreground="#FFFFFF" 
                                    BorderBrush="#3B2E63" 
                                    Background="#1A1433" 
                                    Padding="18,8" 
                                    FontSize="12" 
                                    Cursor="Hand"
                                    Click="BtnCloseProfile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Window>
