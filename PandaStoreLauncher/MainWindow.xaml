                                    <Image Source="pack://application:,,,/Assets/Pasos/1.png" Stretch="Uniform" MaxHeight="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 2 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="2️⃣ Paso 2: Abrir y ejecutar el programa" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Abre el historial de descargas de tu navegador o tu carpeta Descargas y ejecuta 'PandaStoreLauncher.exe' (se recomienda como Administrador)." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/2.png" Stretch="Uniform" MaxHeight="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 3 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="3️⃣ Paso 3: Ingresar tu Clave de Licencia" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Ingresa tu Clave de Licencia (ej: PANDA-XXXX-YYYY) recibida tras tu compra y haz clic en 'DESBLOQUEAR LAUNCHER'." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/3.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 4 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="4️⃣ Paso 4: Ver tus juegos autorizados" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Al ingresar verás la lista completa de todos tus juegos asignados listos para ser inyectados en Steam." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/4.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 5 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="5️⃣ Paso 5: Activar todo en 1-Clic" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Presiona 'ACTIVAR TODO EN 1 CLIC' (o 'APLICAR FIXES A INSTALADOS') para que el launcher inyecte automáticamente todas las licencias y parches en Steam." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/5.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 6 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="6️⃣ Paso 6: Modo Seguro VAC para juegos personales online" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Si deseas jugar online un juego propio de tu cuenta personal (ej: CS2, Warzone), activa 'MODO SEGURO VAC' para limpiar los archivos inyectados de Steam en 3 segundos." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/6.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 7 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="7️⃣ Paso 7: Volver a activar tus juegos de PandaStore" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Cuando quieras volver a jugar los juegos del pack PandaStore, simplemente presiona de nuevo 'ACTIVAR TODO EN 1 CLIC' y 'APLICAR FIXES'." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/7.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 8 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="8️⃣ Paso 8: ¡A disfrutar de tus juegos!" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="¡Todo listo! Abre Steam y disfruta de tu biblioteca completa de más de 150+ juegos." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/8.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#0D0A18" CornerRadius="8" Padding="12">
                        <Grid>
                            <TextBlock Text="¿Tienes más dudas? Contáctanos:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnWhatsapp_Click" Background="#128C7E" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/logowsp.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="WhatsApp Soporte" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnInstagram_Click" Background="#C13584" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/logoig.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Instagram Oficial" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Profile & Gamer Loyalty Overlay Modal (Floating Top-Level Modal) -->
        <Grid x:Name="borderProfileOverlay" 
              Background="#D905020C" 
              Visibility="Collapsed"
              Panel.ZIndex="1000">
