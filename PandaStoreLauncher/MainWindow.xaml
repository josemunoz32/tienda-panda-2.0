                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Clave de Licencia:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileLicenseKey" Text="PANDA-XXXX-YYYY" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
