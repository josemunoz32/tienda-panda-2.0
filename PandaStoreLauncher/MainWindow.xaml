<Window x:Class="PandaStoreLauncher.MainWindow"
        x:Name="launcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PandaStore Launcher" Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        MinHeight="650" MinWidth="950">

    <Grid>
        <!-- Background Image with Overlay -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/bg.jpg" Stretch="UniformToFill" Opacity="0.4"/>
        </Grid.Background>

        <!-- ========================================== -->
        <!-- VIEW 1: LICENSE ACTIVATION / LOGIN VIEW    -->
        <!-- ========================================== -->
        <Grid x:Name="LoginContainer" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" 
                    BorderBrush="#332B56" 
                    BorderThickness="1.5" 
                    CornerRadius="16" 
                    Width="480" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36">
                <Border.Effect>
                    <DropShadowEffect Color="#7C4DFF" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Official Panda Logo -->
                    <Image Source="pack://application:,,,/Assets/miicono.png" Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <TextBlock Text="PANDA STORE" 
                               Foreground="{StaticResource PrimaryGoldBrush}" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="GESTOR OFICIAL DE JUEGOS STEAM" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               FontSize="11" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,16"/>

                    <Button x:Name="btnOpenAdminPanelLogin" 
                            Content="👑 PANEL DE ADMINISTRADOR" 
                            Style="{StaticResource GoldButtonStyle}" 
                            Height="34"
                            Padding="14,4"
                            FontSize="11"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Click="BtnOpenAdminPanel_Click"/>

                    <!-- License Input -->
                    <TextBlock Text="Ingresa tu Código de Acceso:" 
                               Foreground="{StaticResource TextWhiteBrush}" 
                               FontSize="13" 
                               Margin="0,0,0,8"/>

                    
                    <TextBox x:Name="txtLicenseKey" 
                             Text="" 
                             FontSize="15" 
                             FontWeight="SemiBold"
                             Margin="0,0,0,16"
                             KeyDown="TxtLicenseKey_KeyDown"/>

                    <!-- HWID Container -->
                    <Border Background="#100D1F" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID de Hardware de tu Equipo (HWID):" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="lblHwidValue" Text="Cargando..." Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋 Copiar" Click="BtnCopyHwid_Click" Background="#261E44" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Submit Button -->
                    <Button x:Name="btnValidateKey" 
                            Content="🚀 INICIAR LAUNCHER" 
                            Style="{StaticResource GoldButtonStyle}" 
                            Height="46"
                            Click="BtnValidateKey_Click"/>

                    <Button x:Name="btnExploreCatalogGuest"
                            Content="📚 VER CATÁLOGO COMPLETO (+150 JUEGOS)"
                            Style="{StaticResource PurpleButtonStyle}"
                            Height="40"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            Click="BtnExploreCatalogGuest_Click"/>

                    <ProgressBar x:Name="pbLoginLoading" IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="Collapsed" Foreground="{StaticResource PrimaryGoldBrush}"/>

                    <!-- Error / Status Message -->
                    <TextBlock x:Name="lblLoginStatus" 
                               Text="" 
                               Foreground="#FF5252" 
                               FontSize="13" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center" 
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Login View Footer Support Bar -->
            <Border Grid.Row="1" Background="#0D0A18" BorderBrush="#1F1935" BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="BtnOpenHelp_Click" Background="#292244" Foreground="#FFD700" BorderThickness="0" Padding="14,8" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <TextBlock Text="❓ Guía de Uso &amp; Preguntas Frecuentes" VerticalAlignment="Center"/>
                    </Button>

                    <Button Click="BtnWhatsapp_Click" Background="#128C7E" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/logowsp.png" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Soporte WhatsApp (+56 9 7475 1810)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnInstagram_Click" Background="#C13584" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/logoig.png" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Instagram Oficial" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 2: DASHBOARD / GAMES VIEW             -->
        <!-- ========================================== -->
        <Grid x:Name="DashboardContainer" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Navigation Bar -->
            <Border Grid.Row="0" Background="#0C091A" BorderBrush="#1C1632" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand with Official Panda Logo & Client Email -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/miicono.png" Width="44" Height="44" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PANDA STORE" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="GESTOR OFICIAL DE JUEGOS STEAM" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Email Pill Badge -->
                        <Border Background="#130E26" BorderBrush="#251E3D" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="24,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " Foreground="#8B5CF6" FontSize="12"/>
                                <TextBlock x:Name="lblClientEmail" Text="Invitado / Vista Catálogo" Foreground="{StaticResource TextWhiteBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnOpenProfile" 
                                Content="👤 Mi Perfil &amp; Fidelidad" 
                                Style="{StaticResource GoldButtonStyle}" 
                                Padding="14,9"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="0,0,10,0"
                                ToolTip="Ver estado de tu licencia PandaStore y recompensas gamer (10 juegos = 1 de regalo)"
                                Click="BtnOpenProfile_Click"/>

                        <Button x:Name="btnOpenAdminPanel" 
                                Content="👑 Panel Admin" 
                                Style="{StaticResource GoldButtonStyle}" 
                                Padding="14,9"
                                FontSize="12"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                Click="BtnOpenAdminPanel_Click"/>

                        <Button x:Name="btnCheckUpdate" 
                                Content="🚀 Actualizar App" 
                                Style="{StaticResource PurpleButtonStyle}" 
                                Padding="16,9"
                                FontSize="12"
                                Margin="0,0,10,0"
                                Click="BtnCheckUpdate_Click"/>

                        <Button x:Name="btnRefreshGames" 
                                Content="🔄 Refrescar" 
                                Style="{StaticResource VacButtonStyle}" 
                                Foreground="#FFFFFF"
                                BorderBrush="#2A2248"
                                Background="#151026"
                                Padding="14,9"
                                FontSize="12"
                                Click="BtnRefreshGames_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Trial Expiration Notice Banner (Visible only for trial keys) -->
            <Border x:Name="borderTrialNotice" Grid.Row="1" Background="#261805" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Margin="20,12,20,0" Padding="16,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#78350F" CornerRadius="10" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="MODO PRUEBA TEMPORAL (PANDA STORE)" Foreground="#FBBF24" FontWeight="Bold" FontSize="14"/>
                            <Border Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="lblTrialCountdown" Text="Tiempo restante: 15:00" Foreground="#FDE68A" FontWeight="Bold" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Recuerda realizar y confirmar tu pago con el vendedor en menos de 10-15 minutos para conservar tus licencias, partidas y activación permanente de juegos en Steam." Foreground="#FEF3C7" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="💬 Confirmar Pago / Soporte" Click="BtnWhatsapp_Click" Background="#128C7E" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" FontWeight="Bold" FontSize="11" Cursor="Hand" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Games Grid Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <StackPanel>
                    <!-- Antivirus Warning Banner & Specs Bar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="borderAntivirusWarning" Grid.Column="0" Background="#0A1C14" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="lblAntivirusWarningTag" Text="🛡️ ANTIVIRUS OK:" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblAntivirusWarningText" Text="Protección pausada o carpetas en excepción. Los parches se instalarán limpiamente." Foreground="#D1FAE5" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1"
                                Content="🛡️ Auto-Excepción Defender"
                                Style="{StaticResource VacButtonStyle}"
                                Foreground="#FFFFFF"
                                BorderBrush="#3B2E63"
                                Background="#16122C"
                                Padding="12,8"
                                FontSize="11"
                                Margin="0,0,10,0"
                                ToolTip="Añade automáticamente la carpeta de Steam a las excepciones de Windows Defender"
                                Click="BtnAddAntivirusExclusion_Click"/>

                        <Border Grid.Column="2" Background="#13102B" BorderBrush="#251E3D" BorderThickness="1" CornerRadius="10" Padding="14,8">
                            <TextBlock x:Name="lblSystemSpecs" Text="💻 Mi PC: Windows" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Mode Status Banner & Search Bar Row -->
                    <Border Background="#0E0B1A" BorderBrush="#1F1935" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- State message indicator -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#21153B" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                                    <TextBlock x:Name="lblModeStatusIcon" Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblModeStatusTitle" Text="MODO JUEGOS PANDA STORE (ACTIVADO)" Foreground="#10B981" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock x:Name="lblModeStatusSub" Text="Componentes de PandaStore activos en Steam. Puedes activar e instalar libremente tus juegos del catálogo." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Game Search Box & Category -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Categoría:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbCategoryFilter"
                                          Width="160"
                                          Margin="0,0,12,0"
                                          FontSize="12"
                                          SelectionChanged="CmbCategoryFilter_SelectionChanged">
                                    <ComboBoxItem Content="Todas las Categorías" IsSelected="True"/>
                                    <ComboBoxItem Content="💥 Acción / Aventura"/>
                                    <ComboBoxItem Content="⚔️ RPG / Rol"/>
                                    <ComboBoxItem Content="🔫 Shooters / FPS"/>
                                    <ComboBoxItem Content="😱 Terror / Horror"/>
                                    <ComboBoxItem Content="🧠 Estrategia / Sim"/>
                                    <ComboBoxItem Content="🏎️ Carreras / Deportes"/>
                                    <ComboBoxItem Content="🧱 Indie / Casual"/>
                                </ComboBox>

                                <TextBox x:Name="txtSearchGame" 
                                         Width="220"
                                         Padding="12,8" 
                                         FontSize="12"
                                         Text=""
                                         TextChanged="TxtSearchGame_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filter Tabs & Quick Action Bar Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Left Side: Navigation Tabs -->
                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="btnTabAuthorized" 
                                    Content="📅 Mis Juegos" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="14,8" 
                                    FontSize="12" 
                                    Margin="0,0,6,6" 
                                    Click="BtnTabAuthorized_Click"/>

                            <Button x:Name="btnTabInstalled" 
                                    Content="🖥️ Instalados en PC" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="14,8" 
                                    FontSize="12" 
                                    Margin="0,0,6,6" 
                                    Click="BtnTabInstalled_Click"/>

                            <Button x:Name="btnTabNeedsFix" 
                                    Content="🩹 Requieren Fix" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="14,8" 
                                    FontSize="12" 
                                    Margin="0,0,6,6" 
                                    Click="BtnTabNeedsFix_Click"/>

                            <Button x:Name="btnTabAllCatalog" 
                                    Content="📰 Catálogo Total (+150 Juegos)" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="14,8" 
                                    FontSize="12" 
                                    Margin="0,0,10,6" 
                                    Click="BtnTabAllCatalog_Click"/>

                            <TextBlock x:Name="lblGameCount" Visibility="Collapsed"/>

                            <Button x:Name="btnToggleVacSteam" 
                                    Content="🎮 MODO JUEGOS (ACTIVADO)" 
                                    Style="{StaticResource VacButtonStyle}" 
                                    Foreground="#00F0FF"
                                    BorderBrush="#00F0FF"
                                    Background="#0E1B26"
                                    Padding="12,8"
                                    FontSize="11"
                                    Margin="0,0,6,6"
                                    Click="BtnToggleVacSteam_Click"/>

                            <Button x:Name="btnBatchFixAll" 
                                    Content="🛠️ Fixes a Instalados" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="12,8"
                                    FontSize="11"
                                    Margin="0,0,6,6"
                                    Click="BtnBatchFixAll_Click"/>

                            <Button x:Name="btnSelectVisible" 
                                    Content="☑️ Seleccionar Visibles" 
                                    Style="{StaticResource PurpleButtonStyle}" 
                                    Background="#1A1430"
                                    Padding="12,8"
                                    FontSize="11"
                                    Margin="0,0,6,6"
                                    Click="BtnSelectVisible_Click"/>

                            <Button x:Name="btnActivateAll" 
                                    Content="⚡ Activar Seleccionados" 
                                    Style="{StaticResource GoldButtonStyle}" 
                                    Padding="16,8"
                                    FontSize="12"
                                    Margin="0,0,0,6"
                                    Click="BtnActivateAll_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- ItemsControl for Games (Responsive WrapPanel where each game expands independently) -->
                    <ItemsControl x:Name="icGames"
                                  Margin="0,0,0,30"
                                  SizeChanged="IcGames_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0E0A1D" 
                                        BorderBrush="#1F1936" 
                                        BorderThickness="1.5" 
                                        CornerRadius="12" 
                                        Margin="6" 
                                        Padding="14"
                                        VerticalAlignment="Top"
                                        Width="{Binding CardWidth, ElementName=launcherWindow}">
                                    <StackPanel>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Game Cover Poster -->
                                        <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="110" Height="70" Margin="0,0,14,0" Background="#161226" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Always visible fallback background with logo and Game Title -->
                                                <Border Background="#251E3D" Padding="4">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Assets/miicono.png" Width="26" Height="26" Margin="0,0,0,2" Opacity="0.85"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="9" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Steam Image overlaid over the fallback box -->
                                                <Image Source="{Binding CoverImageUrl}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Right: Content & Action Buttons -->
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Title & Options Menu -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Cursor="Hand"
                                                          ToolTip="Marcar para activar este juego"/>
                                                
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}" 
                                                           Foreground="#FFFFFF" 
                                                           FontSize="15" 
                                                           FontWeight="Bold" 
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                 <Button Grid.Column="2" 
                                                         Content="•••" 
                                                         Background="Transparent" 
                                                         Foreground="{StaticResource TextMutedBrush}" 
                                                         BorderThickness="0" 
                                                         FontSize="14" 
                                                         Cursor="Hand" 
                                                         Padding="6,0"
                                                         ToolTip="Opciones del juego"
                                                         Click="BtnGameOptions_Click"
                                                         Tag="{Binding}">
                                                     <Button.ContextMenu>
                                                         <ContextMenu Background="#16122C" Foreground="#FFFFFF" BorderBrush="#3B2E63">
                                                             <MenuItem Header="🧹 Reparar Descarga / Manifiestos" Click="MenuItemRepararDescarga_Click" Tag="{Binding}"/>
                                                             <MenuItem Header="📁 Abrir Carpeta de Instalación" Click="MenuItemOpenGameFolder_Click" Tag="{Binding}"/>
                                                             <MenuItem Header="📋 Copiar AppID de Steam" Click="MenuItemCopyAppId_Click" Tag="{Binding}"/>
                                                         </ContextMenu>
                                                     </Button.ContextMenu>
                                                 </Button>
                                            </Grid>

                                            <!-- Row 1: Status Badge -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding InstallBadgeText}" 
                                                           Foreground="{Binding InstallBadgeColor}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Row 2: Subtext Status & Progress Bar -->
                                            <StackPanel Grid.Row="2" Margin="0,4,0,8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusMessage}" 
                                                           Foreground="#D1D5DB" 
                                                           FontSize="11" 
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"/>
                                                <ProgressBar Value="{Binding ProgressValue}" 
                                                             Maximum="100" 
                                                             Height="4" 
                                                             Foreground="{StaticResource AccentCyanBrush}" 
                                                             Background="#1F1A3A" 
                                                             BorderThickness="0"
                                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Row 3: Action Buttons (Responsive WrapPanel, never clips text) -->
                                            <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="📥 Agregar a la biblioteca" 
                                                        Style="{StaticResource PurpleButtonStyle}" 
                                                        Visibility="{Binding ActivateButtonVisibility}"
                                                        IsEnabled="{Binding CanActivate}"
                                                        Tag="{Binding}" 
                                                        Padding="14,7"
                                                        FontSize="12"
                                                        Margin="0,0,6,6"
                                                        Click="BtnActivarJuego_Click"/>


                                                <!-- Botón VIP '🔑 Activar' exclusivo para juegos VIP (Denuvo / Ubisoft / EA) -->
                                                <Button Content="🔑 Activar" 
                                                        Style="{StaticResource GoldButtonStyle}" 
                                                        Visibility="{Binding VipButtonVisibility}"
                                                        IsEnabled="{Binding CanActivateVip}"
                                                        Tag="{Binding}" 
                                                        Padding="14,7"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Margin="0,0,6,6"
                                                        ToolTip="{Binding VipButtonToolTip}"
                                                        Click="BtnActivarVip_Click"/>

                                                <Button Content="{Binding FixButtonText}" 
                                                        Style="{StaticResource VacButtonStyle}"
                                                        Foreground="#FFFFFF"
                                                        BorderBrush="#3B2E63"
                                                        Background="#1D1735"
                                                        Visibility="{Binding FixButtonVisibility}"
                                                        IsEnabled="{Binding CanInstallFix}"
                                                        Tag="{Binding}" 
                                                        Padding="14,7"
                                                        FontSize="12"
                                                        Margin="0,0,6,6"
                                                        Click="BtnInstalarFix_Click"/>

                                                <Button Content="🎮 Jugar"
                                                        Style="{StaticResource PurpleButtonStyle}"
                                                        Background="#059669"
                                                        Foreground="#FFFFFF"
                                                        FontSize="12"
                                                        Padding="14,7"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding PlayButtonVisibility}"
                                                        IsEnabled="{Binding CanLaunchGame}"
                                                        Tag="{Binding}"
                                                        Click="BtnLanzarJuego_Click"/>

                                                <!-- Botón para ver DLCs -->
                                                <Button Content="{Binding DlcButtonText}" 
                                                        Style="{StaticResource VacButtonStyle}"
                                                        Foreground="#FBBF24"
                                                        BorderBrush="#78350F"
                                                        Background="#1F130B"
                                                        Visibility="{Binding DlcButtonVisibility}"
                                                        Tag="{Binding}" 
                                                        Padding="10,6"
                                                        FontSize="11"
                                                        Margin="0,0,6,6"
                                                        ToolTip="Ver y adquirir DLCs de este juego"
                                                        Click="BtnToggleDlcs_Click"/>

                                                <Button Content="🛒 Comprar Juego"
                                                        Style="{StaticResource GoldButtonStyle}"
                                                        FontSize="11"
                                                        Padding="12,6"
                                                        Margin="0,0,6,6"
                                                        Visibility="{Binding RequestButtonVisibility}"
                                                        Tag="{Binding}"
                                                        Click="BtnSolicitarJuego_Click"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Expandable DLC Drawer -->
                                    <Border Visibility="{Binding DlcDrawerVisibility}" 
                                            Background="#090614" 
                                            BorderBrush="#2D1C48" 
                                            BorderThickness="0,1,0,0" 
                                            Margin="-14,12,-14,-14" 
                                            Padding="14,10" 
                                            CornerRadius="0,0,12,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📦 " FontSize="12"/>
                                                    <TextBlock Text="CONTENIDO DESCARGABLE (DLCs)" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text=" • $1.000 CLP c/u" Foreground="#9CA3AF" FontSize="10" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Dlcs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#120D22" BorderBrush="#201736" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" 
                                                                          IsChecked="{Binding IsSelectedForPurchase, Mode=TwoWay}"
                                                                          Visibility="{Binding PurchaseControlVisibility}"
                                                                          VerticalAlignment="Center" 
                                                                          Margin="0,0,8,0" 
                                                                          Cursor="Hand"/>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" Foreground="#9CA3AF" FontSize="9"/>
                                                                </StackPanel>

                                                                <Border Grid.Column="2" 
                                                                        Background="#16102A" 
                                                                        BorderBrush="{Binding StatusBadgeColor}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="4" 
                                                                        Padding="6,2" 
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusBadgeText}" 
                                                                               Foreground="{Binding StatusBadgeColor}" 
                                                                               FontSize="10" 
                                                                               FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="🛒 Comprar DLCs Seleccionados por WhatsApp" 
                                                    Style="{StaticResource GoldButtonStyle}" 
                                                    FontSize="11" 
                                                    Padding="10,6" 
                                                    Margin="0,4,0,0" 
                                                    Tag="{Binding}"
                                                    Click="BtnBuySelectedDlcs_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Load More Games Pagination Button -->
                    <Button x:Name="btnLoadMoreGames"
                            Content="➕ CARGAR MÁS JUEGOS DE LA LISTA"
                            Style="{StaticResource PurpleButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="24,11"
                            FontSize="13"
                            Margin="0,10,0,30"
                            Visibility="Collapsed"
                            Click="BtnLoadMoreGames_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Dashboard Footer Support Bar -->
            <Border Grid.Row="3" Background="#0C091A" BorderBrush="#1C1632" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- WhatsApp Card -->
                    <Border Grid.Column="0" Background="#0E0B1A" BorderBrush="#1F1935" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" Cursor="Hand" MouseDown="BtnWhatsapp_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#25D366" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/Assets/logowsp.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Soporte WhatsApp" Foreground="{StaticResource TextWhiteBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="(+56 9 7475 1810)" Foreground="{StaticResource AccentCyanBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Instagram Card -->
                    <Border Grid.Column="1" Background="#0E0B1A" BorderBrush="#1F1935" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="10,0,0,0" Cursor="Hand" MouseDown="BtnInstagram_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E1306C" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/Assets/logoig.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Instagram Oficial" Foreground="{StaticResource TextWhiteBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="@pandastoregaming.cl" Foreground="#F472B6" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 3: FAQ / GUÍA Y DUDAS MODAL           -->
        <!-- ========================================== -->
        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Background="#D0000000">
            <Border Background="#161226" BorderBrush="#7C4DFF" BorderThickness="1.5" CornerRadius="16" Width="720" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
