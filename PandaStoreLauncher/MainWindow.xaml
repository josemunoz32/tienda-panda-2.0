                                                     Foreground="{StaticResource PrimaryGoldBrush}" 
                                                     Background="#251E3D" 
                                                     BorderThickness="0" 
                                                     Margin="0,0,0,12"/>

                                        <!-- Motivational text -->
                                        <TextBlock x:Name="lblLoyaltyMotivational" 
