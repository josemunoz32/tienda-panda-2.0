                                                <TextBlock Text="Juegos Autorizados:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileGamesCount" Text="10 juegos" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="DLCs Habilitados:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileDlcsCount" Text="100% Desbloqueados" Foreground="#A855F7" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Gamer Loyalty Card -->
                                <Border Background="#16102E" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🏆 " FontSize="14"/>
                                                <TextBlock Text="PROGRAMA DE FIDELIDAD PANDA" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Border x:Name="borderGamerRank" 
