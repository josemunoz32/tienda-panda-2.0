                                                    BorderBrush="#00F0FF" 
                                                    Background="#0A1822" 
                                                    Padding="10,6" 
                                                    FontSize="11" 
                                                    Cursor="Hand"
                                                    Click="BtnCopyLicenseKey_Click"/>
