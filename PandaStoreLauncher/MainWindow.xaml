                        </StackPanel>
                        <Button Content="❌ Cerrar" Click="BtnCloseHelp_Click" HorizontalAlignment="Right" Background="#251E3D" Foreground="#FFFFFF" BorderThickness="0" Padding="10,6" FontSize="11" Cursor="Hand"/>
                    </Grid>

                    <!-- FAQ Content ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📖 GUÍA PASO A PASO EN IMÁGENES" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Paso 1 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="1️⃣ Paso 1: Descargar PandaStore Launcher (.exe)" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
