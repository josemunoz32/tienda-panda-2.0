<Window x:Class="PandaStoreLauncher.MainWindow"
        x:Name="launcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PandaStore Launcher" Height="790" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        MinHeight="680" MinWidth="1080">

    <Window.Resources>
        <!-- Logo de Telegram (avión de papel) -->
        <Geometry x:Key="TelegramGeometry">M248 8C111 8 0 119 0 256S111 504 248 504 496 393 496 256 385 8 248 8zM363 176.7c-3.7 39.2-19.9 134.4-28.1 178.3-3.5 18.6-10.3 24.8-16.9 25.4-14.4 1.3-25.3-9.5-39.3-18.7-21.8-14.3-34.2-23.2-55.3-37.2-24.5-16.1-8.6-25 5.3-39.5 3.7-3.8 67.1-61.5 68.3-66.7.2-.7.3-3.1-1.2-4.4s-3.6-.8-5.1-.5q-3.3.7-104.6 69.1-14.8 10.2-26.9 9.9c-8.9-.2-25.9-5-38.6-9.1-15.5-5-27.9-7.7-26.8-16.3q.8-6.7 18.5-13.7 108.4-47.2 144.6-62.3c68.9-28.6 83.2-33.6 92.5-33.8 2.1 0 6.6.5 9.6 2.9a10.5 10.5 0 0 1 3.5 6.7A43.8 43.8 0 0 1 363 176.7z</Geometry>

        <!-- Botón compacto de las tarjetas -->
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#181330"/>
            <Setter Property="BorderBrush" Value="#2A2248"/>
        </Style>

        <Style x:Key="Ico" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Botón social redondeado -->
        <Style x:Key="SocialBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#FFFFFF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/bg.jpg" Stretch="UniformToFill" Opacity="0.35"/>
        </Grid.Background>

        <!-- ========================================== -->
        <!-- VIEW 1: LOGIN                               -->
        <!-- ========================================== -->
        <Grid x:Name="LoginContainer" Visibility="Visible">
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#40281455" Offset="0"/>
                    <GradientStop Color="#E605030C" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
                <!-- Logo flotante con halo -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Ellipse Width="180" Height="180" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#55FFC400" Offset="0"/>
                                <GradientStop Color="#228B5CF6" Offset="0.55"/>
                                <GradientStop Color="#008B5CF6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="pack://application:,,,/Assets/miicono.png" Width="100" Height="100">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="logoFloat" Y="0"/>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect Color="#FFC400" BlurRadius="34" ShadowDepth="0" Opacity="0.5"/>
                        </Image.Effect>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="logoFloat" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:2.2">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>

                <TextBlock Text="PANDA STORE" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-26,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFF1A0" Offset="0"/>
                            <GradientStop Color="#FFC400" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFC400" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="GESTOR OFICIAL DE JUEGOS STEAM" Foreground="#9C96B8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,16"/>

                <!-- Tarjeta con borde degradado -->
                <Border Width="470" CornerRadius="20" Padding="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#AAFFD700" Offset="0"/>
                            <GradientStop Color="#332A1F55" Offset="0.45"/>
                            <GradientStop Color="#AA8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#7C4DFF" BlurRadius="60" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                    <Border Background="#F50C0918" CornerRadius="19" Padding="34,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Iniciar sesión" Foreground="#FFFFFF" FontSize="21" FontWeight="Bold"/>
                                    <TextBlock Text="Ingresa tu código de acceso para abrir tu biblioteca" Foreground="#8D86AD" FontSize="12.5" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="btnOpenAdminPanelLogin"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Foreground="#FFD700"
                                        Padding="10,5"
                                        FontSize="11"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed"
                                        Click="BtnOpenAdminPanel_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" Style="{StaticResource Ico}" FontSize="12"/>
                                        <TextBlock Text="Admin"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="CÓDIGO DE ACCESO" Foreground="#7E77A0" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,18">
                                <TextBox x:Name="txtLicenseKey"
                                         Text=""
                                         FontSize="17"
                                         FontWeight="SemiBold"
                                         FontFamily="Consolas"
                                         Background="#0A0815"
                                         BorderBrush="#2E2550"
                                         Padding="48,15,14,15"
                                         KeyDown="TxtLicenseKey_KeyDown"/>
                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" Foreground="#FFD700" FontSize="17" VerticalAlignment="Center" Margin="17,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="PANDA-XXXX-XXXX" Foreground="#3F3960" FontSize="17" FontFamily="Consolas" VerticalAlignment="Center" Margin="50,0,0,0" IsHitTestVisible="False"
                                           Visibility="{Binding Text.IsEmpty, ElementName=txtLicenseKey, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                            <TextBlock Text="ID DE HARDWARE DE TU EQUIPO" Foreground="#7E77A0" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#0A0815" BorderBrush="#231C3E" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" Foreground="#00F0FF" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" x:Name="lblHwidValue" Text="Cargando..." Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Click="BtnCopyHwid_Click" Style="{StaticResource GhostButtonStyle}" Padding="10,5" FontSize="11" Margin="10,0,0,0" ToolTip="Copiar HWID">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Ico}" FontSize="12"/>
                                            <TextBlock Text="Copiar"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button x:Name="btnValidateKey"
                                    Style="{StaticResource GoldButtonStyle}"
                                    FontSize="15"
                                    Height="52"
                                    Click="BtnValidateKey_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFC400" BlurRadius="26" ShadowDepth="0" Opacity="0.45"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="INICIAR LAUNCHER" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="10,1,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnExploreCatalogGuest"
                                    Content="Ver catálogo completo (+150 juegos)"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="42"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed"
                                    Click="BtnExploreCatalogGuest_Click"/>

                            <ProgressBar x:Name="pbLoginLoading" IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="Collapsed" BorderThickness="0" Background="#1A1430" Foreground="{StaticResource PrimaryGoldBrush}"/>

                            <TextBlock x:Name="lblLoginStatus"
                                       Text=""
                                       Foreground="#FF5252"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,12,0,0"/>

                            <Button Click="BtnOpenHelp_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#8D86AD">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="t" Text="¿Cómo funciona? Ver guía de uso y preguntas frecuentes" FontSize="12" Foreground="#A9A3C4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="t" Property="Foreground" Value="#FFD700"/>
                                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Canales oficiales -->
                <TextBlock Text="SÍGUENOS Y RECIBE SOPORTE" Foreground="#5F5880" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="BtnWhatsapp_Click" Style="{StaticResource SocialBtn}" Background="#1F9D55" ToolTip="Soporte por WhatsApp: +56 9 7475 1810">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/logowsp.png" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="WhatsApp" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnTelegram_Click" Style="{StaticResource SocialBtn}" Background="#229ED9" ToolTip="Canal oficial: ofertas, packs nuevos y sorteos">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource TelegramGeometry}" Fill="White" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Telegram" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnInstagram_Click" Style="{StaticResource SocialBtn}" ToolTip="@pandastoregaming.cl">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#F58529" Offset="0"/>
                                <GradientStop Color="#DD2A7B" Offset="0.5"/>
                                <GradientStop Color="#8134AF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/logoig.png" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Instagram" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 2: DASHBOARD (sidebar + contenido)    -->
        <!-- ========================================== -->
        <Grid x:Name="DashboardContainer" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{StaticResource SideBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,18,20">
                        <Image Source="pack://application:,,,/Assets/miicono.png" Width="40" Height="40" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PANDA STORE" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="18" FontWeight="Black"/>
                            <TextBlock Text="GAME LAUNCHER" Foreground="#6E6790" FontSize="9.5" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0">
                        <StackPanel>
                            <TextBlock Text="BIBLIOTECA" Foreground="#5F5880" FontSize="10" FontWeight="Bold" Margin="12,0,0,8"/>
                            <Button x:Name="btnTabAuthorized" Style="{StaticResource NavItemStyle}" Tag="&#xE8F1;" Content="Mi biblioteca" Click="BtnTabAuthorized_Click"/>
                            <Button x:Name="btnTabInstalled" Style="{StaticResource NavItemStyle}" Tag="&#xEDA2;" Content="Instalados" Click="BtnTabInstalled_Click"/>
                            <Button x:Name="btnTabNeedsFix" Style="{StaticResource NavItemStyle}" Tag="&#xE7BA;" Content="Atención requerida" Visibility="Collapsed" Click="BtnTabNeedsFix_Click"/>
                            <Button x:Name="btnTabAllCatalog" Style="{StaticResource NavItemStyle}" Tag="&#xE909;" Content="Explorar catálogo" Click="BtnTabAllCatalog_Click"/>

                            <TextBlock Text="HERRAMIENTAS" Foreground="#5F5880" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
                            <Button x:Name="btnStaticManualActivator" Style="{StaticResource NavItemStyle}" Tag="&#xE8D7;" Foreground="#FFD700" Content="Activar por AppID"
                                    ToolTip="Abrir el Activador oficial (PandaStoreActivator.exe) para ingresar tu AppID manualmente"
                                    Click="BtnOpenManualActivator_Click"/>
                            <Button x:Name="btnRepararSteam" Style="{StaticResource NavItemStyle}" Tag="&#xE90F;" Content="Reparar Steam"
                                    ToolTip="Cierra procesos colgados de Steam, purga caché corrupta y comprueba inyectores automáticamente"
                                    Click="BtnRepararSteam_Click"/>
                            <Button x:Name="btnOpenAdminPanel" Style="{StaticResource NavItemStyle}" Tag="&#xE734;" Foreground="#FFD700" Content="Administración" Visibility="Collapsed"
                                    Click="BtnOpenAdminPanel_Click"/>
                            <!-- Guardados: retirado del menú (se mantiene oculto por compatibilidad) -->
                            <Button x:Name="btnOpenSaves" Visibility="Collapsed" Click="BtnOpenSaves_Click"/>

                            <TextBlock Text="COMUNIDAD" Foreground="#5F5880" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
                            <Button Style="{StaticResource NavItemStyle}" Foreground="#C9C4DA" ToolTip="Ofertas, packs nuevos y sorteos" Click="BtnTelegram_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource TelegramGeometry}" Fill="#29A9EB" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Canal de Telegram" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemStyle}" Foreground="#C9C4DA" ToolTip="+56 9 7475 1810" Click="BtnWhatsapp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/logowsp.png" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Soporte WhatsApp" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemStyle}" Foreground="#C9C4DA" ToolTip="@pandastoregaming.cl" Click="BtnInstagram_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/logoig.png" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Instagram" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemStyle}" Tag="&#xE897;" Content="Guía y FAQ" Click="BtnOpenHelp_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cuenta -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFD700" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border CornerRadius="16" Background="#120E22">
                                    <Image Source="pack://application:,,,/Assets/miicono.png" Margin="3"/>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="lblClientEmail" Text="Invitado / Vista Catálogo" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Mi cuenta PandaStore" Foreground="#7E77A0" FontSize="10.5"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="btnOpenProfile" Style="{StaticResource GhostButtonStyle}" Padding="8,6"
                                    ToolTip="Mi cuenta: estado de tu licencia PandaStore y recompensas gamer (10 juegos = 1 de regalo)"
                                    Click="BtnOpenProfile_Click">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ CONTENIDO ============ -->
            <Grid Grid.Column="1" Background="#C0080612">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid MaxWidth="520" HorizontalAlignment="Left" Width="520">
                            <TextBox x:Name="txtSearchGame"
                                     Padding="42,10,14,10"
                                     FontSize="13"
                                     Text=""
                                     Background="#E6120E22"
                                     BorderBrush="#2A2248"
                                     BorderThickness="1"
                                     TextChanged="TxtSearchGame_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="#7E77A0" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Buscar juegos en el catálogo..." Foreground="#5F5880" FontSize="13" VerticalAlignment="Center" Margin="44,0,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=txtSearchGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E6120E22" BorderBrush="#2A2248" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" Foreground="#00F0FF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblSystemSpecs" Text="Mi PC: Windows" Foreground="#C9F7FF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E6120E22" BorderBrush="#2A2248" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,8,0" ToolTip="Versión instalada del launcher">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblLauncherVersion" Text="v—" Foreground="#A9A3C4" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="btnCheckUpdate" Content="Actualizar" Style="{StaticResource GoldButtonStyle}" Padding="14,8" FontSize="12"
                                    Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCheckUpdate_Click"/>
                            <Button x:Name="btnRefreshGames" Style="{StaticResource GhostButtonStyle}" Padding="12,8" Click="BtnRefreshGames_Click"
                                    ToolTip="Sincronizar catálogo, licencia y estado de instalación con Steam">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Ico}"/>
                                    <TextBlock Text="Sincronizar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,18,0">
                    <StackPanel>
                        <!-- Banner prueba temporal -->
                        <Border x:Name="borderTrialNotice" Background="#E6261805" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12" Margin="0,0,0,14" Padding="16,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" Foreground="#FBBF24" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="MODO PRUEBA TEMPORAL" Foreground="#FBBF24" FontWeight="Bold" FontSize="13"/>
                                        <Border Background="#451A03" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="lblTrialCountdown" Text="Tiempo restante: 15:00" Foreground="#FDE68A" FontWeight="Bold" FontSize="11.5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Recuerda realizar y confirmar tu pago con el vendedor en menos de 10-15 minutos para conservar tus licencias, partidas y activación permanente de juegos en Steam." Foreground="#FEF3C7" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Confirmar pago" Click="BtnWhatsapp_Click" Style="{StaticResource GhostButtonStyle}" Background="#128C7E" BorderBrush="#128C7E" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Encabezado de sección -->
                        <Grid Margin="0,0,10,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="Juegos" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold"/>
                                <TextBlock x:Name="lblGameCount" Text="Cargando catálogo..." Foreground="#8D86AD" FontSize="13" VerticalAlignment="Bottom" Margin="14,0,0,7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="Categoría" Foreground="#8D86AD" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbCategoryFilter" Width="190" FontSize="12" SelectionChanged="CmbCategoryFilter_SelectionChanged">
                                    <ComboBoxItem Content="Todas las Categorías" IsSelected="True"/>
                                    <ComboBoxItem Content="💥 Acción / Aventura"/>
                                    <ComboBoxItem Content="⚔️ RPG / Rol"/>
                                    <ComboBoxItem Content="🔫 Shooters / FPS"/>
                                    <ComboBoxItem Content="😱 Terror / Horror"/>
                                    <ComboBoxItem Content="🧠 Estrategia / Sim"/>
                                    <ComboBoxItem Content="🏎️ Carreras / Deportes"/>
                                    <ComboBoxItem Content="🧱 Indie / Casual"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Estado del modo -->
                        <Grid Margin="0,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#21153B" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0">
                                        <TextBlock x:Name="lblModeStatusIcon" Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="lblModeStatusTitle" Text="MODO JUEGOS PANDA STORE (ACTIVADO)" Foreground="#10B981" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock x:Name="lblModeStatusSub" Text="Componentes de PandaStore activos en Steam." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" x:Name="btnToggleVacSteam"
                                    Content="🎮 MODO JUEGOS (ACTIVADO)"
                                    Style="{StaticResource VacButtonStyle}"
                                    Foreground="#00F0FF" BorderBrush="#00F0FF" Background="#0E1B26"
                                    Padding="16,10" FontSize="11.5"
                                    Click="BtnToggleVacSteam_Click"/>
                        </Grid>

                        <!-- Antivirus + accesos rápidos -->
                        <Border x:Name="borderAntivirusWarning" Background="#E60A1C14" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblAntivirusWarningTag" Text="ANTIVIRUS OK:" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="lblAntivirusWarningText" Text="Protección pausada o carpetas en excepción." Foreground="#D1FAE5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="btnCopySteamPath" Style="{StaticResource GhostButtonStyle}" Padding="10,5" FontSize="11" Margin="8,0,0,0"
                                            ToolTip="Copia la ruta exacta de tu Steam para añadirla a Avast, AVG, McAfee u otros antivirus"
                                            Click="BtnCopySteamPath_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Ico}" FontSize="11"/>
                                            <TextBlock Text="Copiar ruta"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Añade automáticamente la carpeta de Steam a las excepciones de Windows Defender"
                                            Click="BtnAddAntivirusExclusion_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource Ico}" FontSize="11"/>
                                            <TextBlock Text="Excepción Defender"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Acciones masivas -->
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="btnSelectVisible" Content="Seleccionar visibles" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,6" Click="BtnSelectVisible_Click"/>
                            <Button x:Name="btnBatchFixAll" Content="Fixes a instalados" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,6" Visibility="Collapsed" Click="BtnBatchFixAll_Click"/>
                            <Button x:Name="btnActivateAll" Style="{StaticResource GoldButtonStyle}" Padding="16,8" FontSize="12" Margin="0,0,0,6" Click="BtnActivateAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Ico}" FontSize="12"/>
                                    <TextBlock Text="Agregar seleccionados"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- ============ GRILLA DE CARÁTULAS ============ -->
                        <ItemsControl x:Name="icGames" Margin="-8,0,0,20" SizeChanged="IcGames_SizeChanged">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Stretch: todas las tarjetas de una fila tienen el mismo alto -->
                                    <Border Style="{StaticResource GameCardStyle}" Margin="8" VerticalAlignment="Stretch"
                                            Width="{Binding CardWidth, ElementName=launcherWindow}">
                                        <DockPanel LastChildFill="False">
                                            <!-- Póster: bordes redondeados reales (ImageBrush respeta CornerRadius) -->
                                            <Grid DockPanel.Dock="Top" Height="{Binding PosterHeight, ElementName=launcherWindow}">
                                                <Border CornerRadius="12.5,12.5,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#2A1756" Offset="0"/>
                                                            <GradientStop Color="#120B26" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                                        <Image Source="pack://application:,,,/Assets/miicono.png" Width="56" Height="56" Opacity="0.85" Margin="0,0,0,8"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="12.5,12.5,0,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding CoverImageUrl, Converter={StaticResource PosterImg}}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border CornerRadius="12.5,12.5,0,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding PosterImageUrl, Converter={StaticResource PosterImg}}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border VerticalAlignment="Bottom" Height="90">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#000F0B1D" Offset="0"/>
                                                            <GradientStop Color="#F20F0B1D" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Border Background="#B3000000" CornerRadius="8" Padding="6,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand" ToolTip="Marcar para activar este juego"/>
                                                </Border>

                                                <Button Style="{StaticResource GhostButtonStyle}" Background="#B3000000" BorderBrush="Transparent" Foreground="#FFFFFF"
                                                        Padding="7,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                                        ToolTip="Opciones del juego" Click="BtnGameOptions_Click" Tag="{Binding}">
                                                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="#16122C" Foreground="#FFFFFF" BorderBrush="#3B2E63">
                                                            <MenuItem Header="Reparar descarga / manifiestos" Click="MenuItemRepararDescarga_Click" Tag="{Binding}">
                                                                <MenuItem.Icon><TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" Foreground="#C4B5FD"/></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Abrir carpeta de instalación" Click="MenuItemOpenGameFolder_Click" Tag="{Binding}">
                                                                <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Foreground="#FBBF24"/></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Copiar AppID de Steam" Click="MenuItemCopyAppId_Click" Tag="{Binding}">
                                                                <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Foreground="#00F0FF"/></MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <Border Background="#D90A0714" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,10,10">
                                                    <TextBlock Text="{Binding InstallBadgeText}" Foreground="{Binding InstallBadgeColor}" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>

                                            <!-- Título + estado (alto fijo) -->
                                            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#9C96B8" FontSize="11" TextTrimming="CharacterEllipsis" Height="16" Margin="0,3,0,0" ToolTip="{Binding StatusMessage}"/>
                                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                             Foreground="{StaticResource PrimaryGoldBrush}" Background="#1F1A3A" BorderThickness="0"
                                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Cajón de DLCs -->
                                            <Border DockPanel.Dock="Top" Visibility="{Binding DlcDrawerVisibility}"
                                                    Background="#090614" BorderBrush="#2D1C48" BorderThickness="1" CornerRadius="10" Margin="12,10,12,0" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="DLCs • $1.000 CLP c/u" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="11" FontWeight="Bold" Margin="2,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding Dlcs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#120D22" BorderBrush="#201736" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsSelectedForPurchase, Mode=TwoWay}" Visibility="{Binding PurchaseControlVisibility}"
                                                                                  VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"/>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" Foreground="#9CA3AF" FontSize="9"/>
                                                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeColor}" FontSize="9" FontWeight="Bold" Margin="8,0,0,0"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="Comprar DLCs por WhatsApp" Style="{StaticResource GoldButtonStyle}" FontSize="11" Padding="8,6" Margin="0,4,0,0"
                                                            Tag="{Binding}" Click="BtnBuySelectedDlcs_Click"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Acciones: SIEMPRE abajo y con alto fijo -->
                                            <StackPanel DockPanel.Dock="Bottom" Margin="9,10,9,12">
                                                <UniformGrid Rows="1" Height="36">
                                                    <Button Style="{StaticResource PurpleButtonStyle}" Padding="6,0" Margin="3,0" FontSize="12"
                                                            Visibility="{Binding ActivateButtonVisibility}" IsEnabled="{Binding CanActivate}"
                                                            Tag="{Binding}" ToolTip="Agregar a la biblioteca de Steam" Click="BtnActivarJuego_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE710;" Style="{StaticResource Ico}"/>
                                                            <TextBlock Text="Agregar"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GoldButtonStyle}" Padding="6,0" Margin="3,0" FontSize="12"
                                                            Visibility="{Binding VipButtonVisibility}" IsEnabled="{Binding CanActivateVip}"
                                                            Tag="{Binding}" ToolTip="{Binding VipButtonToolTip}" Click="BtnActivarVip_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Ico}"/>
                                                            <TextBlock Text="Activar"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PurpleButtonStyle}" Background="#059669" Padding="6,0" Margin="3,0" FontSize="12"
                                                            Visibility="{Binding PlayButtonVisibility}" IsEnabled="{Binding CanLaunchGame}"
                                                            Tag="{Binding}" ToolTip="Jugar" Click="BtnLanzarJuego_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE768;" Style="{StaticResource Ico}"/>
                                                            <TextBlock Text="Jugar"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GoldButtonStyle}" Padding="6,0" Margin="3,0" FontSize="12"
                                                            Visibility="{Binding RequestButtonVisibility}"
                                                            Tag="{Binding}" ToolTip="Comprar este juego" Click="BtnSolicitarJuego_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7BF;" Style="{StaticResource Ico}"/>
                                                            <TextBlock Text="Comprar"/>
                                                        </StackPanel>
                                                    </Button>
                                                </UniformGrid>
                                                <!-- Fila secundaria: espacio reservado aunque esté vacía -->
                                                <UniformGrid Rows="1" Height="32" Margin="0,6,0,0">
                                                    <Button Style="{StaticResource CardBtn}" Visibility="{Binding FixButtonVisibility}" IsEnabled="{Binding CanInstallFix}"
                                                            Tag="{Binding}" ToolTip="Instalar Fix / parche" Click="BtnInstalarFix_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE90F;" Style="{StaticResource Ico}" Foreground="#C4B5FD"/>
                                                            <TextBlock Text="Fix"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource CardBtn}" Visibility="{Binding SyncDlcsButtonVisibility}" IsEnabled="{Binding CanActivate}"
                                                            Tag="{Binding}" ToolTip="Aplica y activa todos los DLCs de tu biblioteca en Steam" Click="BtnSincronizarDlcs_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE945;" Style="{StaticResource Ico}" Foreground="#A78BFA"/>
                                                            <TextBlock Text="DLCs"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource CardBtn}" Visibility="{Binding DlcButtonVisibility}"
                                                            Tag="{Binding}" ToolTip="{Binding DlcButtonText}" Click="BtnToggleDlcs_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Ico}" Foreground="#FBBF24"/>
                                                            <TextBlock Text="Ver"/>
                                                        </StackPanel>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="btnLoadMoreGames"
                                Content="Cargar más juegos"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="28,11"
                                FontSize="13"
                                Margin="0,4,0,30"
                                Visibility="Collapsed"
                                Click="BtnLoadMoreGames_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 3: FAQ / GUÍA Y DUDAS MODAL           -->
        <!-- ========================================== -->
        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Background="#D0000000">
            <Border Background="#161226" BorderBrush="#7C4DFF" BorderThickness="1.5" CornerRadius="16" Width="720" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="❓ GUÍA DE USO Y PREGUNTAS FRECUENTES" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Content="❌ Cerrar" Click="BtnCloseHelp_Click" HorizontalAlignment="Right" Background="#251E3D" Foreground="#FFFFFF" BorderThickness="0" Padding="10,6" FontSize="11" Cursor="Hand"/>
                    </Grid>

                    <!-- FAQ Content ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📖 GUÍA PASO A PASO EN IMÁGENES" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Paso 1 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="1️⃣ Paso 1: Descargar PandaStore Launcher (.exe)" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Descarga el archivo autoejecutable PandaStoreLauncher.exe desde la página oficial de PandaStore." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/1.png" Stretch="Uniform" MaxHeight="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 2 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="2️⃣ Paso 2: Abrir y ejecutar el programa" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Abre el historial de descargas de tu navegador o tu carpeta Descargas y ejecuta 'PandaStoreLauncher.exe' (se recomienda como Administrador)." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/2.png" Stretch="Uniform" MaxHeight="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 3 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="3️⃣ Paso 3: Ingresar tu Clave de Licencia" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Ingresa tu Clave de Licencia (ej: PANDA-XXXX-YYYY) recibida tras tu compra y haz clic en 'DESBLOQUEAR LAUNCHER'." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/3.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 4 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="4️⃣ Paso 4: Ver tus juegos autorizados" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Al ingresar verás la lista completa de todos tus juegos asignados listos para ser inyectados en Steam." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/4.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 5 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="5️⃣ Paso 5: Activar todo en 1-Clic" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Presiona 'ACTIVAR TODO EN 1 CLIC' (o 'APLICAR FIXES A INSTALADOS') para que el launcher inyecte automáticamente todas las licencias y parches en Steam." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/5.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 6 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="6️⃣ Paso 6: Modo Seguro VAC para juegos personales online" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Si deseas jugar online un juego propio de tu cuenta personal (ej: CS2, Warzone), activa 'MODO SEGURO VAC' para limpiar los archivos inyectados de Steam en 3 segundos." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/6.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 7 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="7️⃣ Paso 7: Volver a activar tus juegos de PandaStore" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Cuando quieras volver a jugar los juegos del pack PandaStore, simplemente presiona de nuevo 'ACTIVAR TODO EN 1 CLIC' y 'APLICAR FIXES'." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/7.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Paso 8 -->
                            <Border Background="#100D1F" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="8️⃣ Paso 8: ¡A disfrutar de tus juegos!" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="¡Todo listo! Abre Steam y disfruta de tu biblioteca completa de más de 150+ juegos." Foreground="{StaticResource TextWhiteBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <Image Source="pack://application:,,,/Assets/Pasos/8.png" Stretch="Uniform" MaxHeight="320"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#0D0A18" CornerRadius="8" Padding="12">
                        <Grid>
                            <TextBlock Text="¿Tienes más dudas? Contáctanos:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnWhatsapp_Click" Background="#128C7E" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/logowsp.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="WhatsApp Soporte" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnTelegram_Click" Background="#229ED9" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource TelegramGeometry}" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Canal de Telegram" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Profile & Gamer Loyalty Overlay Modal (Floating Top-Level Modal) -->
        <Grid x:Name="borderProfileOverlay" 
              Background="#D905020C" 
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <Border Width="680" 
                    MaxHeight="680" 
                        Background="#100B22" 
                        BorderBrush="#4C2889" 
                        BorderThickness="1.5" 
                        CornerRadius="16" 
                        Padding="28" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#251648" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0" Padding="5">
                                    <Image Source="pack://application:,,,/Assets/miicono.png" Stretch="Uniform"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TU CUENTA PANDASTORE" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Licencia, beneficios y progreso de fidelidad" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Content="✕" 
                                    Background="Transparent" 
                                    Foreground="#9CA3AF" 
                                    BorderThickness="0" 
                                    FontSize="18" 
                                    FontWeight="Bold" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Cursor="Hand"
                                    Click="BtnCloseProfile_Click"/>
                        </Grid>

                        <!-- Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- License Details Card -->
                                <Border Background="#16102E" BorderBrush="#2C2050" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⌁ ESTADO DE TU LICENCIA" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                        
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Clave de Licencia:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileLicenseKey" Text="PANDA-XXXX-YYYY" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Content="📋 Copiar Clave" 
                                                    Style="{StaticResource VacButtonStyle}" 
                                                    Foreground="#00F0FF" 
                                                    BorderBrush="#00F0FF" 
                                                    Background="#0A1822" 
                                                    Padding="10,6" 
                                                    FontSize="11" 
                                                    Cursor="Hand"
                                                    Click="BtnCopyLicenseKey_Click"/>
                                        </Grid>

                                        <Separator Background="#261C44" Margin="0,4,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Correo Vinculado:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileEmail" Text="cliente@email.com" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Estado:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileStatus" Text="✔ Activa &amp; Verificada" Foreground="#10B981" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock x:Name="lblProfileValidity" Text="Vigencia: permanente" Foreground="#A78BFA" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Juegos Autorizados:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileGamesCount" Text="10 juegos" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="DLCs Habilitados:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="lblProfileDlcsCount" Text="100% Desbloqueados" Foreground="#A855F7" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Gamer Loyalty Card -->
                                <Border Background="#16102E" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✦ " FontSize="14"/>
                                                <TextBlock Text="BENEFICIOS Y FIDELIDAD" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Border x:Name="borderGamerRank" 
                                                    HorizontalAlignment="Right" 
                                                    Background="#2D1C08" 
                                                    BorderBrush="#F59E0B" 
                                                    BorderThickness="1" 
                                                    CornerRadius="12" 
                                                    Padding="10,3">
                                                <TextBlock x:Name="lblGamerRank" Text="🥈 Panda Pro Gamer" Foreground="#FBBF24" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock x:Name="lblLoyaltySubtitle" 
                                                   Text="¡Cada 10 juegos que compras en PandaStore te dan derecho a 1 juego completamente GRATIS a tu elección!" 
                                                   Foreground="#D1D5DB" 
                                                   FontSize="11" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,0,0,12"/>

                                        <!-- Progress Bar -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Progreso del ciclo actual:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock x:Name="lblLoyaltyProgressText" Text="8 / 10 Juegos" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <ProgressBar x:Name="pbLoyaltyCycle" 
                                                     Value="8" 
                                                     Maximum="10" 
                                                     Height="10" 
                                                     Foreground="{StaticResource PrimaryGoldBrush}" 
                                                     Background="#251E3D" 
                                                     BorderThickness="0" 
                                                     Margin="0,0,0,12"/>

                                        <!-- Motivational text -->
                                        <TextBlock x:Name="lblLoyaltyMotivational" 
                                                   Text="¡Te faltan solo 2 juegos para reclamar tu juego GRATIS!" 
                                                   Foreground="#34D399" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   Margin="0,0,0,14"/>

                                        <!-- Claim Gift Button -->
                                        <Button x:Name="btnClaimLoyaltyReward" 
                                                Content="🎁 Reclamar Juego Gratis por WhatsApp" 
                                                Style="{StaticResource GoldButtonStyle}" 
                                                Padding="14,10" 
                                                FontSize="12" 
                                                FontWeight="Bold" 
                                                Cursor="Hand"
                                                Click="BtnClaimLoyaltyReward_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cerrar" 
                                    Style="{StaticResource VacButtonStyle}" 
                                    Foreground="#FFFFFF" 
                                    BorderBrush="#3B2E63" 
                                    Background="#1A1433" 
                                    Padding="18,8" 
                                    FontSize="12" 
                                    Cursor="Hand"
                                    Click="BtnCloseProfile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Window>
