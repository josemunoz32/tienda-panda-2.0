                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MI PERFIL &amp; FIDELIDAD GAMER" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="18" FontWeight="Bold"/>
