                                                    BorderBrush="#F59E0B" 
                                                    BorderThickness="1" 
                                                    CornerRadius="12" 
                                                    Padding="10,3">
                                                <TextBlock x:Name="lblGamerRank" Text="🥈 Panda Pro Gamer" Foreground="#FBBF24" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock x:Name="lblLoyaltySubtitle" 
                                                   Text="¡Cada 10 juegos que compras en PandaStore te dan derecho a 1 juego completamente GRATIS a tu elección!" 
                                                   Foreground="#D1D5DB" 
                                                   FontSize="11" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,0,0,12"/>

                                        <!-- Progress Bar -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Progreso del ciclo actual:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock x:Name="lblLoyaltyProgressText" Text="8 / 10 Juegos" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <ProgressBar x:Name="pbLoyaltyCycle" 
