                    MaxHeight="680" 
                        Background="#100B22" 
                        BorderBrush="#4C2889" 
                        BorderThickness="1.5" 
                        CornerRadius="16" 
                        Padding="28" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
