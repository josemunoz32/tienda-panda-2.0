<Window x:Class="PandaStoreLauncher.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👑 PandaStore - Panel Admin de Licencias" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0A0814">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#140F2A" BorderBrush="#332B56" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👑" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="PANEL DE ADMINISTRACIÓN DE LICENCIAS" Foreground="{StaticResource PrimaryGoldBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Gestión de suscripciones, estados de cliente y HWID en tiempo real" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRegisterAdminHwid"
                            Content="📌 Vincular Mi HWID Admin"
                            Style="{StaticResource GoldButtonStyle}"
                            Padding="12,8"
                            FontSize="11"
                            Margin="0,0,10,0"
                            Click="BtnRegisterAdminHwid_Click"/>

                    <Button x:Name="btnRefreshLicenses"
                            Content="🔄 Refrescar"
                            Style="{StaticResource PurpleButtonStyle}"
                            Padding="12,8"
                            FontSize="11"
                            Click="BtnRefreshLicenses_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Bar & Stats -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Buscar Licencia:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtSearchLicense" Width="300" Padding="10,6" FontSize="12" TextChanged="TxtSearchLicense_TextChanged"/>
            </StackPanel>

            <TextBlock x:Name="lblLicenseStats" Grid.Column="1" Text="Cargando licencias..." Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- DataGrid / Table of Licenses -->
        <Border Grid.Row="2" Background="#0E0B1C" BorderBrush="#211A3A" BorderThickness="1" CornerRadius="12" Padding="10">
            <DataGrid x:Name="dgLicenses"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="Transparent"
                      RowBackground="#120E24"
                      AlternatingRowBackground="#181330"
                      Foreground="#FFFFFF"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#282046"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      FontSize="12"
                      RowHeight="42">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1434"/>
                        <Setter Property="Foreground" Value="#FFD700"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <!-- Key -->
                    <DataGridTextColumn Header="Clave Licencia" Binding="{Binding Key}" Width="160" IsReadOnly="True"/>

                    <!-- Email -->
                    <DataGridTextColumn Header="Cliente / Email" Binding="{Binding ClientEmail}" Width="180"/>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Estado" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Padding="8,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#064E3B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="suspended">
                                                        <Setter Property="Background" Value="#7F1D1D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type -->
                    <DataGridTemplateColumn Header="Tipo" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LicenseType}" Foreground="{StaticResource PrimaryGoldBrush}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Expiry Date -->
                    <DataGridTextColumn Header="Vencimiento (AAAA-MM-DD)" Binding="{Binding ExpiryDate}" Width="170"/>

                    <!-- HWID -->
                    <DataGridTextColumn Header="HWID Equipamiento" Binding="{Binding Hwid}" Width="160" IsReadOnly="True"/>

                    <!-- Last Seen -->
                    <DataGridTextColumn Header="Última Conexión" Binding="{Binding LastSeen}" Width="150" IsReadOnly="True"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Acciones" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="💾 Guardar"
                                            Click="BtnSaveRow_Click"
                                            Background="#2D1B69"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            Cursor="Hand"/>

                                    <Button Content="🚫 Suspender / Activar"
                                            Click="BtnToggleStatusRow_Click"
                                            Background="#991B1B"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            Cursor="Hand"/>

                                    <Button Content="🔓 Desvincular HWID"
                                            Click="BtnResetHwidRow_Click"
                                            Background="#374151"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            FontSize="10"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#140F2A" BorderBrush="#332B56" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
            <Grid>
                <TextBlock Text="💡 Tip: Al 'Suspender' a un cliente, PandaChecker eliminará automáticamente sus archivos .lua en 24h sin notificarle." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="❌ Cerrar Panel" Click="BtnClose_Click" HorizontalAlignment="Right" Background="#374151" Foreground="#FFFFFF" BorderThickness="0" Padding="12,6" FontSize="11" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
