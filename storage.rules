rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        (
          request.auth.token.pandaStorageAdmin == true ||
          (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
            (
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin" ||
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "super_admin" ||
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "superadmin"
            )
          )
        );
    }
    // Imágenes de productos: solo admin puede escribir, todos pueden leer
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Imágenes de perfil: solo el usuario puede leer/escribir
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Imágenes de testimonios: solo admin puede escribir, todos pueden leer
    match /testimonios/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Comprobantes privados por usuario; el panel los gestiona mediante Admin SDK.
    match /comprobantes/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Comprobantes de distribuidores B2B
    match /comprobantes_distribuidor/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // Comprobantes de recargas de billetera B2B.
    match /comprobantes_billetera/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // Fotos de reseñas: subida solo por el dueño; lectura pública para mostrarlas.
    match /reviews/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Fixes y parches de juegos para PandaStore Launcher
    match /fixes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
