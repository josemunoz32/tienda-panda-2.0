{
  "rules": {
    "presence": {
      "$sessionId": {
        ".read": true,
        ".write": "!newData.exists() || (newData.hasChildren(['online', 'lastSeen']) && newData.child('online').isBoolean() && newData.child('online').val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['online', 'lastSeen'])"
      },
      ".read": "auth != null && auth.token.role === 'admin'"
    },
    ".read": false,
    ".write": false
  }
}
