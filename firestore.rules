rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin", "superadmin"];
    }
    function hasActiveSteamDistributorAccess() {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && (
        account.role == "admin" ||
        (account.steam_distributor == true && account.distributor_status == "active")
      );
    }
    function keepsDistributorAccessFieldsUntouched() {
      let forbidden = [
        "role", "resellerStatus", "revendedor_desde", "steam_distributor", "steamDistributor", "distributor_status",
        "distributor_plan", "custom_quota", "extra_keys", "distributor_expires_at",
        "distributor_since", "pandaPoints"
      ];
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let currentBal = !("wallet_balance" in resource.data) ? 0 : resource.data.wallet_balance;
      let validWallet = !diff.hasAny(["wallet_balance"]) ||
        (
          request.resource.data.wallet_balance is number &&
          request.resource.data.wallet_balance >= 0 &&
          request.resource.data.wallet_balance <= currentBal
        );
      return !diff.hasAny(forbidden) && validWallet;
    }
    function isSafeClientProfileCreate() {
      let forbidden = [
        "steam_distributor", "steamDistributor", "distributor_status", "distributor_plan",
        "custom_quota", "extra_keys", "distributor_expires_at", "distributor_since",
        "revendedor_desde", "wallet_balance"
      ];
      return request.resource.data.role == "user" &&
        !request.resource.data.keys().hasAny(forbidden) &&
        (!("resellerStatus" in request.resource.data) || request.resource.data.resellerStatus == "pendiente") &&
        (!("pandaPoints" in request.resource.data) || request.resource.data.pandaPoints <= 50);
    }

    // Reseñas públicas: el cliente puede proponer una, pero siempre entra pendiente.
    // Así se admite a invitados sin que puedan inyectar campos administrativos o publicarla solos.
    function isValidTestimonialReview() {
      return request.resource.data.keys().hasOnly([
          "rating", "nombre", "categoria", "juego", "comentario", "foto", "userAvatar",
          "isGuest", "userId", "userEmail", "createdAt", "fecha", "verified", "visible", "source"
        ]) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 50 &&
        request.resource.data.comentario is string &&
        request.resource.data.comentario.size() >= 10 && request.resource.data.comentario.size() <= 500 &&
        request.resource.data.createdAt is number &&
        request.resource.data.visible == false;
    }

    // Permitir lectura global de reseñas (collectionGroup) solo a admin autenticados
    match /{document=**}/reviews/{reviewId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Permitir lectura global de preguntas (collectionGroup) solo a admin autenticados
    match /{document=**}/questions/{questionId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Usuarios: lectura autenticada; creación de usuario propio; actualización por admin o por el propio usuario (perfil, billetera, compras distribuidor)
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && isSafeClientProfileCreate();
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && keepsDistributorAccessFieldsUntouched())
      );
      allow delete: if isAdmin();
    }

    // Categorías
    match /categories/{categoryId} {
      allow create, update, delete: if isAdmin();
      allow read: if true;
    }

    // Productos
    match /products/{productId} {
      allow create, update, delete: if isAdmin() || signedIn();
      allow read: if true;

      // Subcolección de reseñas
      match /reviews/{reviewId} {
        allow read: if true;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      }

      // Subcolección de preguntas y respuestas
      match /questions/{questionId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        allow update: if request.auth != null &&
          (request.auth.uid == resource.data.userId ||
          (request.resource.data.answer != null &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
      }
    }

    // Carrito, favoritos y pedidos de cada usuario
    match /users/{userId}/cart/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/favorites/{favId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Colección global de pedidos: admin puede leer, actualizar y eliminar, todos pueden crear (incluyendo invitados)
    match /orders/{orderId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid) || request.resource.data.uid == "guest";
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Testimonios oficiales (fotos de entregas): admin escribe, todos leen
    match /testimonios/{testimonioId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Reseñas de clientes: siempre pendientes hasta la aprobación del administrador.
    match /testimonios_reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidTestimonialReview() && (
        (signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.isGuest == false) ||
        (!signedIn() && request.resource.data.userId == "guest" && request.resource.data.isGuest == true &&
          request.resource.data.verified == false)
      );
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Soporte: tickets y mensajes
    match /soporte/{ticketId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        resource.data.email == request.auth.token.email
      );
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";

      match /mensajes/{mensajeId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/soporte/$(ticketId)).data.email == request.auth.token.email
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/soporte/$(ticketId)).data.email == request.auth.token.email
        );
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }
    }

    // Packs Nintendo
    match /packs_nintendo/{packId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Solicitudes de Revendedores B2B
    match /solicitudes_revendedores/{solicitudId} {
      // Documento determinista por UID: autenticado, una sola solicitud y
      // sin posibilidad de postular en nombre de otra persona.
      allow create: if signedIn() && solicitudId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.estado == "pendiente";
      // El solicitante puede consultar su documento determinista incluso
      // antes de que exista; así se evita un falso "permisos insuficientes"
      // al comprobar si ya había postulado.
      allow read: if signedIn() && (isAdmin() || solicitudId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Solicitudes de Distribuidores Steam B2B
    match /solicitudes_distribuidores/{solicitudId} {
      allow create: if signedIn();
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Recargas de Billetera B2B
    match /recargas_billetera/{recargaId} {
      allow create: if signedIn();
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Historial y Movimientos de Billetera Virtual
    match /wallet_transactions/{transactionId} {
      allow create: if signedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Cupones: lectura y uso público para checkout; solo admin crea y elimina
    match /cupones/{cuponId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isAdmin();
    }

    // Sistema de Referidos
    match /referrals/{referralId} {
      allow create: if signedIn() && request.resource.data.referrerUid == request.auth.uid;
      allow read: if signedIn() && (request.auth.uid == resource.data.referrerUid || isAdmin());
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Campañas de Email
    match /emailCampaigns/{campaignId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Eventos de analítica
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Carritos abandonados
    match /abandonedCarts/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow create, update: if request.auth != null &&
        request.auth.uid == userId && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Licencias de PandaStore Launcher
    match /licenses/{licenseId} {
      allow read: if true;
      allow create: if signedIn() && (
        isAdmin() ||
        (hasActiveSteamDistributorAccess() &&
         request.resource.data.distributor_id == request.auth.uid)
      );
      allow update: if (
        signedIn() && (
          isAdmin() ||
          (hasActiveSteamDistributorAccess() &&
           resource.data.distributor_id == request.auth.uid)
        )
      ) || (
        // Permite al PandaStore Launcher vincular el HWID del cliente en la primera activación
        // o actualizar su última conexión (last_seen), sin permitir modificar claves ni juegos.
        resource.data.status == "active" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "hwid", "last_seen", "activated_at", "activatedAt", "expires_at", "expiresAt", "updatedAt", "updated_at"
        ]) && (
          // Si el documento ya tenía HWID asignado, no se puede cambiar a un HWID distinto
          (!("hwid" in resource.data) || resource.data.hwid == null) ||
          (request.resource.data.hwid == resource.data.hwid)
        ) && (
          // Si la petición define o cambia HWID, debe ser un string válido de al menos 4 caracteres
          !("hwid" in request.resource.data) ||
          request.resource.data.hwid == null ||
          (request.resource.data.hwid is string && request.resource.data.hwid.size() >= 4)
        )
      );
      allow delete: if isAdmin();
    }

    // Juegos y Fixes de PandaStore Launcher
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Configuración y Actualizaciones del Launcher
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración Global de la Tienda (Dólar, Divisas, Tasas de cambio, Stock Overrides)
    match /config/{configId} {
      allow read, write: if true;
    }

    // Ajustes y Overrides Administrativos (Stock Switch, etc.)
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
